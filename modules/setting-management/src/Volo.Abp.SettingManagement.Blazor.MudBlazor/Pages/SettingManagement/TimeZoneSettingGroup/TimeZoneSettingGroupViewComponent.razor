@using Volo.Abp.SettingManagement.Localization
@using MudBlazor
@inherits Volo.Abp.AspNetCore.Components.AbpComponentBase

@if (TimezoneSettings != null)
{
    <MudForm>
        <MudGrid>
            <MudItem xs="12">
                <MudSelect T="string"
                          Label="@L["DisplayName:Timezone"]"
                          Required="true"
                          RequiredError="@L["ThisFieldIsRequired"]"
                          Value="@TimezoneSettings.Timezone"
                          ValueChanged="@OnSelectedValueChangedAsync"
                          Variant="Variant.Outlined">
                    @foreach (var item in TimezoneSettings.TimeZoneItems)
                    {
                        <MudSelectItem Value="@item.Value">@item.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudText Typo="Typo.caption" Class="mt-1">@L["TimezoneHelpText"]</MudText>
            </MudItem>
        </MudGrid>
        <MudGrid>
            <MudItem xs="12">
                <MudButton Color="Color.Primary"
                          Variant="Variant.Filled"
                          OnClick="@UpdateSettingsAsync">
                    @L["Save"]
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudForm>
}
