@using Microsoft.AspNetCore.Components.Routing
@if (Menu != null)
{
    <MudNavMenu>
        @foreach (var menuItem in Menu.Items)
        {
            @if (menuItem.Items.IsNullOrEmpty())
            {
                <MudNavLink Href="@menuItem.Url" Match="@(menuItem.Url != null ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                    <MudIcon Icon="@menuItem.Icon" Size="Size.Small" />
                    <MudText Class="ms-1" Inline="true">@menuItem.DisplayName</MudText>
                </MudNavLink>
            }
            else
            {
                <FirstLevelNavMenuItem MenuItem="menuItem" />
            }
        }
    </MudNavMenu>
}
