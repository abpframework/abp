<Project Sdk="Microsoft.NET.Sdk.Web">

  <Import Project="..\..\..\common.test.props" />

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>Volo.Abp.AgentTools.Mcp.Tests</AssemblyName>
    <PackageId>Volo.Abp.AgentTools.Mcp.Tests</PackageId>
    <!-- The XML docs of the sample services are tool descriptions. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PreserveCompilationReferences>true</PreserveCompilationReferences>
    <!-- Program.cs is the entry point (WebApplicationFactory); the test SDK's generated one only causes CS7022. -->
    <GenerateProgramFile>false</GenerateProgramFile>
    <RootNamespace />
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Volo.Abp.AgentTools.Mcp\Volo.Abp.AgentTools.Mcp.csproj" />
    <ProjectReference Include="..\..\src\Volo.Abp.AspNetCore.MultiTenancy\Volo.Abp.AspNetCore.MultiTenancy.csproj" />
    <ProjectReference Include="..\..\src\Volo.Abp.AspNetCore.TestBase\Volo.Abp.AspNetCore.TestBase.csproj" />
    <ProjectReference Include="..\..\src\Volo.Abp.EntityFrameworkCore.Sqlite\Volo.Abp.EntityFrameworkCore.Sqlite.csproj" />
    <ProjectReference Include="..\Volo.Abp.AgentTools.Tests\Volo.Abp.AgentTools.Tests.csproj" />
  </ItemGroup>

  <!-- https://github.com/NuGet/Home/issues/4412 : WebApplicationFactory needs the referenced projects' deps.json -->
  <Target Name="CopyDepsFiles" AfterTargets="Build" Condition="'$(TargetFramework)'!=''">
    <ItemGroup>
      <DepsFilePaths Include="$([System.IO.Path]::ChangeExtension('%(_ResolvedProjectReferencePaths.FullPath)', '.deps.json'))" />
    </ItemGroup>

    <Copy SourceFiles="%(DepsFilePaths.FullPath)" DestinationFolder="$(OutputPath)" Condition="Exists('%(DepsFilePaths.FullPath)')" />
  </Target>

</Project>
