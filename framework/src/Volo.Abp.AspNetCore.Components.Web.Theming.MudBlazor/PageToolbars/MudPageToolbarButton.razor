@using global::MudBlazor

<MudButton Variant="@Variant.Filled"
           Color="@Color.Primary"
           Disabled="Disabled"
           OnClick="@OnClickCallback">
    @if (Icon is string iconString && !string.IsNullOrWhiteSpace(iconString))
    {
        <MudIcon Icon="@iconString" Class="me-1" />
    }
    @Text
</MudButton>

