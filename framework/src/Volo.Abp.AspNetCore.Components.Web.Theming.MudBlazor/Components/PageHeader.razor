@using Microsoft.AspNetCore.Components.Web
@using Volo.Abp.Ui.Branding
@inject IBrandingProvider BrandingProvider

<MudGrid Class="entry-row">
    @if (PageLayout.Title.IsNullOrEmpty())
    {
        <PageTitle>@BrandingProvider.AppName</PageTitle>
    }
    else
    {
        <PageTitle>@PageLayout.Title | @BrandingProvider.AppName</PageTitle>
    }

    @if (Options.Value.RenderPageTitle)
    {
        <MudItem xs="12" sm="6">
            <MudText Typo="Typo.h4" Class="content-header-title">
                @PageLayout.Title
            </MudText>
        </MudItem>
    }

    @if (Options.Value.RenderBreadcrumbs && PageLayout.BreadcrumbItems.Any())
    {
        <MudItem xs="12" sm="6">
            <MudBreadcrumbs MaxItems="4">
                @if (BreadcrumbShowHome)
                {
                    <MudBreadcrumbItem Href="/">
                        <MudIcon Icon="@Icons.Material.Filled.Home" />
                    </MudBreadcrumbItem>
                }
                @foreach (var item in PageLayout.BreadcrumbItems)
                {
                    <MudBreadcrumbItem Href="@item.Url">
                        @item.Text
                    </MudBreadcrumbItem>
                }
            </MudBreadcrumbs>
        </MudItem>
    }

    @if (Options.Value.RenderToolbar)
    {
        <MudItem xs="12">
            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="1">
                @if (Toolbar == null)
                {
                    @ChildContent
                }

                @foreach (var toolbarItemRender in ToolbarItemRenders)
                {
                    <MudStackItem>
                        @toolbarItemRender
                    </MudStackItem>
                }
            </MudStack>
        </MudItem>
    }
</MudGrid>


