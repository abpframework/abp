<Project>
  <!-- SDK 11.0.100 RC 2 and RC 3 add a build-only dotnet-watch JS initializer to every Web SDK project, and a Debug
       build of a Web SDK project fails when it references a Web SDK library that contributes one.
       Remove this file once ABP targets an SDK that no longer has this regression. -->
  <PropertyGroup Condition="$(NETCoreSdkVersion.StartsWith('11.0.100-rc.')) and '$(Configuration)' == 'Debug' and '$(UsingMicrosoftNETSdkWeb)' == 'true' and '$(OutputType)' == 'Library' and '$(EnableHotReloadInRuntimeConfigDevFile)' == ''">
    <EnableHotReloadInRuntimeConfigDevFile>false</EnableHotReloadInRuntimeConfigDevFile>
  </PropertyGroup>

  <!-- SDK 11.0.100 RC builds give the compressed copies of net11.0 package assets duplicate labels, so a Blazor host fails
       on startup when two packages have a static asset with the same path. Remove this once the SDK fixes it. -->
  <PropertyGroup Condition="$(NETCoreSdkVersion.StartsWith('11.0.100-rc.')) and '$(UsingMicrosoftNETSdkWeb)' == 'true' and '$(CompressionEnabled)' == ''">
    <CompressionEnabled>false</CompressionEnabled>
  </PropertyGroup>
</Project>
