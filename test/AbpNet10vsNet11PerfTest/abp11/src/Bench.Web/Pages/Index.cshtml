                                            <i class="bi bi-box-arrow-up-right text-dark fs-6"></i>
                                        </a>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="ps-0">
                                        <div class="d-flex align-items-center">
                                            <img src="~/images/getting-started/youtube.svg" class="me-2">
                                            <div>YouTube</div>
                                        </div>
                                    </td>
                                    <td class="text-end pe-0 opacity-50 align-middle">
                                        <a href="https://www.youtube.com/@@Volosoft" target="_blank">
                                            <i class="bi bi-box-arrow-up-right text-dark fs-6"></i>
                                        </a>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="ps-0 border-bottom-0">
                                        <div class="d-flex align-items-center">
                                            <img src="~/images/getting-started/instagram.svg" class="me-2">
                                            <div>Instagram</div>
                                        </div>
                                    </td>
                                    <td class="text-end pe-0 opacity-50
                                        border-bottom-0 align-middle">
                                        <a href="https://www.instagram.com/abpframework/" target="_blank">
                                            <i class="bi bi-box-arrow-up-right text-dark fs-6"></i>
                                        </a>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
