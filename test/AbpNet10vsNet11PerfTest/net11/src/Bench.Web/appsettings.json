{
  "App": {
    "SelfUrl": "https://localhost:44377",
    "HealthCheckUrl": "/health-status"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/logs.txt"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=Bench;User ID=root;Password=myPassword;"
  },
  "AuthServer": {
    "Authority": "https://localhost:44377",
    "RequireHttpsMetadata": true,
    "CertificatePassPhrase": "9b3fcdc9-9e29-4862-96c7-18239226ee42"
  },
  "StringEncryption": {
    "DefaultPassPhrase": "lbDaoKm9fpgPV9Yy"
  }
}
