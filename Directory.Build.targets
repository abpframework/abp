<Project>
  <!-- SDK 11.0.100 RC 2 and RC 3 add a build-only dotnet-watch JS initializer to every Web SDK project, and a Debug
       build of a Web SDK project fails when it references a Web SDK project that contributes one.
       Remove this file once the repository targets an SDK that no longer has this regression. -->
  <PropertyGroup Condition="$(NETCoreSdkVersion.StartsWith('11.0.100-rc.')) and '$(UsingMicrosoftNETSdkWeb)' == 'true' and ('$(OutputType)' == 'Library' or $(MSBuildProjectFullPath.Contains('test')))">
    <EnableHotReloadInRuntimeConfigDevFile>false</EnableHotReloadInRuntimeConfigDevFile>
  </PropertyGroup>
</Project>
